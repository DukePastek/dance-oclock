# Two separate Supabase projects back the two environments — use the matching
# project's connection string depending on which branch/environment you're running:
#   - main (production): project bexpctselcyjzpiayydq
#   - develop:            project oeasbagypsvnkkxorkvu
# Get each project's password from the Supabase dashboard (Project Settings > Database).
SUPABASE_DB_CONNECTION_STRING=Host=aws-0-eu-west-3.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxxxxxxxxxx;Password=YOUR_SUPABASE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
JWT_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
